<?xml version="1.0" encoding="utf-8"?>
<!-- Widget dessiné par l'app : une image, un message d'attente, et une zone de toucher optionnelle -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:contentDescription="Montée" android:visibility="gone"/>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp" android:background="@drawable/w_bg_linen"
        android:textColor="#FF121212" android:textSize="14sp" android:textStyle="bold"
        android:text="Ouvre Montée pour afficher ce widget"/>
    <TextView android:id="@+id/w_btn" android:layout_width="130dp" android:layout_height="44dp"
        android:layout_gravity="bottom|end" android:visibility="gone" android:contentDescription="T'as joué ?" android:text=""/>
</FrameLayout>
